{
  "name": "hormuz-fleet-command",
  "version": "0.20.0",
  "description": "Hormuz - Fleet Command",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "legacy": "electron . --legacy",
    "build:renderer": "vite build",
    "preview": "vite build && electron . --prod",
    "build": "vite build && electron-builder --win --x64",
    "build-portable": "vite build && electron-builder --win portable --x64",
    "build-folder": "vite build && electron-builder --win dir --x64",
    "test": "node tests/sim.test.mjs && node tests/gameloop.test.mjs && node tests/render.test.mjs && node tests/smoke-test.js && node tests/engine-smoke-test.js"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "three": "^0.186.1",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.hormuz.fleetcommand",
    "productName": "Hormuz Fleet Command",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "out/renderer/**/*",
      "game.html",
      "js/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "HormuzFleetCommand-Setup.exe",
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hormuz Fleet Command",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "differentialPackage": false
    },
    "portable": {
      "artifactName": "HormuzFleetCommand.exe"
    },
    "compression": "normal",
    "npmRebuild": false
  },
  "author": "Fleet Command",
  "license": "MIT"
}
